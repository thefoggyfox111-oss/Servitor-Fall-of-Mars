+ D.rectangle((x+28,y+24,x+114,y+131),outline=(90,106,104,255),width=5)
+ if i in (3,4,6,7):
+  D.rectangle((x+40,y+39,x+100,y+104),fill=(13,119,138,255) if i in (4,7) else (214,87,20,255))
+  D.rectangle((x+48,y+49,x+93,y+91),fill=(57,215,202,255) if i in (4,7) else (248,171,53,255))
+ if i in (2,5):
+  D.polygon([(x+31,y+24),(x+111,y+24),(x+104,y+132),(x+68,y+145),(x+31,y+132)],fill=(115,25,32,255))
