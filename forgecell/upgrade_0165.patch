+"""Build standalone fallback Gothic-Mars atlas when supplied concept images are absent.
+The source distribution ships reference-based environment.fcex; this generator is
+for cloud builds without access to private reference images.
+"""
+from PIL import Image, ImageDraw
+import random, math, struct, zlib, json
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+canvas=Image.new('RGBA',(1024,1024),(0,0,0,0))
+random.seed(40999)
+# Mars skyline, layered silhouettes and steel cathedral details
+sky=Image.new('RGB',(704,396))
+d=ImageDraw.Draw(sky)
+for y in range(396):
+ t=y/395
+ d.line([(0,y),(704,y)], fill=(round(83+85*t),round(29+38*t),round(35+17*t)))
+for layer in range(4):
+ base=[240,281,333,389][layer]
+ tint=[(94,36,41),(79,32,38),(58,29,38),(35,24,34)][layer]
+ x=-24
+ while x<730:
+  w=random.randint(19,48); h=random.randint(30,117)
+  d.rectangle((x,base-h,x+w,396),fill=tint)
+  d.polygon([(x+8,base-h),(x+w//2,base-h-random.randint(6,32)),(x+w-8,base-h)],fill=tint)
+  if w>30:
+   d.rectangle((x+w//2-2,base-h-20,x+w//2+1,base-h-4),fill=tint)
+  if layer>0:
+   for wy in range(base-h+24,base-8,19):
+    for wx in range(x+7,x+w-6,10):
+     if random.random()<.7:d.rectangle((wx,wy,wx+2,wy+4),fill=(142,63,37))
+  x+=w-3
+canvas.paste(sky,(0,0))
+# Dark gothic arches in alpha layer
+arch=Image.new('RGBA',(704,396));da=ImageDraw.Draw(arch)
+for x in range(0,704,165):
+ da.rectangle((x,100,x+14,394),fill=(22,43,51,235))
+ da.rectangle((x+137,100,x+151,394),fill=(22,43,51,235))
+ da.rectangle((x,97,x+151,112),fill=(22,43,51,235))
+ da.line([(x+15,118),(x+77,164),(x+137,118)],fill=(64,82,85,235),width=8)
+ for y in range(140,380,60):
+  da.rectangle((x+2,y,x+12,y+9),fill=(107,112,94,200))
+canvas.alpha_composite(arch,(0,404))
+# Metal plate tiles in grid
+for i in range(4):
+ x=712+76*i; y=2
+ dr=ImageDraw.Draw(canvas)
+ dr.rectangle((x,y,x+71,y+71),fill=(31+i*3,38+i*4,43+i*3,255),outline=(145,93,44,255),width=3)
+ dr.rectangle((x+7,y+7,x+65,y+65),outline=(108,87,61,255),width=3)
+ for ox in (7,61):
+  for oy in (7,61):dr.ellipse((x+ox-2,y+oy-2,x+ox+2,y+oy+2),fill=(194,132,55,255))
+ if i==1:
+  dr.ellipse((x+21,y+21,x+51,y+51),outline=(181,132,61,255),width=4)
+ if i==2:
+  for j in range(6):dr.line((x+10+j*9,y+14,x+10+j*9,y+60),fill=(12,20,30,255),width=3)
+# horizontal platform rail
+D=ImageDraw.Draw(canvas)
+D.rectangle((712,94,1000,161),fill=(24,27,30,255),outline=(206,129,47,255),width=4)
+for x in range(728,999,32):
+ D.rectangle((x,97,x+15,117),fill=(113,79,48,255),outline=(245,167,71,255),width=2)
+ D.line((x+9,120,x+17,150),fill=(98,71,48,255),width=4)
+# 8 object sprites in 2x4 grid
